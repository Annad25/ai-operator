OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model with solid tool calling. Check openrouter.ai/models (filter: tools).
MODEL=openai/gpt-4o-mini
# Comma-separated fallbacks, tried in order on 429/5xx
FALLBACK_MODELS=
ERP_URL=http://127.0.0.1:8800
# 1 = reuse cached LLM responses for identical prompts (free reruns while developing)
LLM_CACHE=1
